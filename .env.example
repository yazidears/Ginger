# All values are server-side. No NEXT_PUBLIC credentials.
# Copy to .env.local; application works without any values.
# Create client: https://app.deepfire.co/settings/api-clients
# Prefer the client pair below so tokens renew automatically.
DEEPFIRE_TOKEN=
# Alternatively token exchange via POST https://api.deepfire.co/v1/token:
DEEPFIRE_CLIENT_ID=
DEEPFIRE_CLIENT_SECRET=
# Native LSASAF NetCDF is authentication-protected. Decoder provision is separate.
# Absolute path to operator-normalized JSON observation array:
MTG_NORMALIZED_FILE=
# Absolute path to polygonized ELMFIRE time-of-arrival GeoJSON:
ELMFIRE_PERIMETERS_FILE=
# Optional authenticated WeatherNext 3 point export. Absolute path, never under public/.
# Separate ensemble evidence; never replaces Open-Meteo silently.
WEATHERNEXT_NORMALIZED_FILE=
# Used by the optional Python exporter only; Earth Engine registered project.
GOOGLE_CLOUD_PROJECT=
# Sage AI analysis: server-side OpenAI Responses API. No key is sent to the browser.
OPENAI_API_KEY=
# Optional Responses-compatible model override; default gpt-6-astra.
SAGE_MODEL=gpt-6-astra

# Optional persistent simulation result directory (long-running Node deployment).
# SAGE_RUN_DIR=/absolute/path/to/sage-runs

# Ash continuous voice: vendor key stays on this server.
SLNG_API_KEY=
# Separate app bearer token, minimum 32 characters. Enter only this token in Ash.
ASH_ACCESS_TOKEN=
# Hosted Nova 3 English + Aura 2 English currently support these two gateways.
SLNG_BASE_URL=https://us-east.api.slng.ai
SLNG_VOICE=aura-2-thalia-en

# Persistent Catalonia exposure GeoJSON shared by web and backend worker.
# Import with scripts/import-catalonia-exposure.py; defaults under .ginger-data/exposure/.
# GINGER_EXPOSURE_FILE=/absolute/path/to/catalonia.geojson

# Public Ginger sender (E.164); enables the home-watch Open Messages link.
GINGER_IMESSAGE_CONTACT=
# Optional Photon-compatible address geocoder. Public demo is for light use only.
GINGER_GEOCODER_URL=https://photon.komoot.io/api/

# AshConnect operator access; same secret in web and iMessage worker (32+ characters).
ASHCONNECT_OPERATOR_TOKEN=
IMESSAGE_PORT=4112

# Only for a separate public demo with isolated rooms, scenarios and saved runs.
# Allows Ash visitors to create/join rooms without an operator login.
# GINGER_PUBLIC_DEMO=1
# GINGER_ASH_ROOM_TOKEN=<separate-random-signing-secret-at-least-32-characters>
