# Explicit transport: imessage, vonage, or telegram. Keep disabled until configured.
ASHCONNECT_ENABLED=false
ASHCONNECT_TRANSPORT=imessage
# Keep Telegram primary while enabling a separately provisioned Photon line.
ASHCONNECT_IMESSAGE_ENABLED=false
# Legacy enablement is still supported for existing Photon installations.
IMESSAGE_ENABLED=false
IMESSAGE_PROJECT_ID=
IMESSAGE_PROJECT_SECRET=
IMESSAGE_WEBHOOK_SECRET=
IMESSAGE_PORT=4112
# Vonage WhatsApp Messages API Sandbox (demo, not production alert delivery).
VONAGE_API_KEY=
VONAGE_API_SECRET=
# Sender from Vonage Sandbox dashboard: international digits without +.
VONAGE_WHATSAPP_SENDER=
# Generate a separate random secret (32+ characters); append ?token=... to BOTH webhook URLs.
VONAGE_WEBHOOK_TOKEN=
# Optional additional verification when Vonage signed webhooks are enabled.
VONAGE_SIGNATURE_SECRET=
# Telegram uses getUpdates long polling; no public webhook required.
TELEGRAM_BOT_TOKEN=
# Optional web-side fallback only; running worker gets public username from getMe.
GINGER_TELEGRAM_BOT_USERNAME=
# Set the same random secret (32+ characters) in the web app .env.local.
# Server-side bridge key; never use a provider API key here.
ASHCONNECT_OPERATOR_TOKEN=
# Uses these from Ginger's .env.local when present. Choose a tool-capable text model.
NEBIUS_API_KEY=
NEBIUS_MODEL=

# Optional explicit alternative to Nebius using an existing OpenAI account:
# IMESSAGE_MODEL_PROVIDER=openai
# IMESSAGE_MODEL=gpt-4.1-mini
# OPENAI_API_KEY=
