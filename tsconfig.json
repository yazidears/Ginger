{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "next.config.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-sage/types/**/*.ts",
    ".next-sage/dev/types/**/*.ts",
    ".next-upgrade/types/**/*.ts",
    ".next-upgrade/dev/types/**/*.ts",
    ".next-sage-production/types/**/*.ts",
    ".next-sage-production/dev/types/**/*.ts",
    ".next-deepfire/types/**/*.ts",
    ".next-deepfire/dev/types/**/*.ts",
    ".next-watch/types/**/*.ts",
    ".next-watch/dev/types/**/*.ts",
    ".next-investigation/types/**/*.ts",
    ".next-investigation/dev/types/**/*.ts",
    ".next-replay/types/**/*.ts",
    ".next-replay/dev/types/**/*.ts",
    ".next-satellite-lab/types/**/*.ts",
    ".next-satellite-lab/dev/types/**/*.ts",
    ".next-receptivity/types/**/*.ts",
    ".next-receptivity/dev/types/**/*.ts",
    ".next-replay-check/types/**/*.ts",
    ".next-replay-check/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".offloaded-node-modules",
    ".offloaded-next"
  ]
}
