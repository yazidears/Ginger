{
  "name": "ginger-wildfire-intelligence",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-satellite.cjs && node scripts/test-core.cjs && node scripts/test-assessment.cjs && node scripts/test-monitor.cjs && npm run test:sage && node scripts/test-sage.cjs && npm run test:investigation && npm run test:replay",
    "test:sage": "tsx scripts/test-sage.ts && tsx scripts/test-structural.ts",
    "test:upgrades": "node scripts/test-provider-reliability.cjs && node scripts/test-watch-areas.cjs && node scripts/test-intelligence.cjs && tsx scripts/test-operations.ts",
    "check:deepfire": "tsx scripts/check-deepfire.ts",
    "test:ash": "node scripts/test-ash.cjs && node scripts/test-ash-voice.cjs",
    "test:investigation": "tsx scripts/test-investigation.ts",
    "fetch:ginger-o1": "python3 scripts/fetch-ginger-o1-data.py",
    "backtest:ginger-o1": "tsx scripts/backtest-ginger-o1.ts",
    "benchmark:ginger-o1": "tsx scripts/benchmark-ginger-o1-grid.ts",
    "backtest:perimeters": "tsx scripts/backtest-ginger-o1-perimeters.ts",
    "test:ginger-o1": "tsx scripts/test-ginger-o1.ts",
    "typecheck:ginger-o1": "tsc --project tsconfig.ginger-o1.json",
    "benchmark:ginger-o1:runtime": "tsx scripts/benchmark-ginger-o1-runtime.ts",
    "test:prevention": "node scripts/test-prevention-refresh.cjs && tsx scripts/test-prevention-opportunity.ts && tsx scripts/test-deepfire-context.ts && NODE_OPTIONS=--conditions=react-server tsx scripts/test-prevention-workflow.ts",
    "train:ginger-o2": "tsx scripts/train-ginger-o2.ts",
    "test:ginger-o2": "tsx scripts/test-ginger-o2-grass.ts && tsx scripts/test-ginger-o2-smoke.ts && tsx scripts/test-ginger-o2-engine.ts",
    "typecheck:ginger-o2": "tsc --project tsconfig.ginger-o2.json",
    "backend": "NODE_OPTIONS=--conditions=react-server tsx scripts/backend-worker.ts",
    "test:backend": "tsx scripts/test-backend-snapshots.ts",
    "test:replay": "tsx scripts/test-replay.ts",
    "backtest:replay": "tsx scripts/backtest-replay.ts",
    "imessage": "npm --prefix integrations/imessage start",
    "test:imessage": "npm --prefix integrations/imessage test",
    "typecheck:imessage": "npm --prefix integrations/imessage run typecheck",
    "typecheck:replay": "tsc --project tsconfig.replay.json",
    "test:satellite-lab": "tsx scripts/test-satellite-lab.ts && tsx scripts/test-satellite-spread.ts",
    "typecheck:satellite-lab": "tsc --project tsconfig.satellite-lab.json",
    "test:exposure": "tsx scripts/test-exposure.ts",
    "test:prevention-score": "tsx scripts/test-prevention-score.ts",
    "test:dryness": "NODE_OPTIONS=--conditions=react-server tsx scripts/test-vegetation-dryness.ts && node scripts/test-vegetation-dryness-view.cjs",
    "test:map": "tsx scripts/test-shared-map.ts",
    "test:receptivity": "tsx scripts/receptivity/test.ts",
    "typecheck:receptivity": "tsc --project tsconfig.receptivity.json",
    "refresh:receptivity": "tsx scripts/receptivity/refresh.ts",
    "prepare:receptivity": ".venv-receptivity/bin/python scripts/receptivity/prepare-geography.py",
    "refresh:vegetation": ".venv-receptivity/bin/python scripts/receptivity/refresh-vegetation.py"
  },
  "dependencies": {
    "@cbevins/fire-behavior-simulator": "0.7.4",
    "lucide-react": "^0.577.0",
    "maplibre-gl": "^6.10.0",
    "next": "^16.0.0",
    "pngjs": "7.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "suncalc": "1.9.0",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/suncalc": "^1.9.2",
    "typescript": "^5.8.0"
  }
}
